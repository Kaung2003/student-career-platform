# Postgres connection string (direct postgres:// URL, not prisma+postgres://)
DATABASE_URL=postgresql://user:password@localhost:5432/career_platform

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=4000

# Allowed browser origins, comma-separated. Leave unset in development to allow all.
CORS_ORIGIN=

# Comma-separated emails that become admins when they log in
ADMIN_EMAILS=

# AI chat assistant + interview feedback
GEMINI_API_KEY=

# Optional: Cloudflare R2 file uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
