# Postgres connection string (direct postgres:// URL, not prisma+postgres://)
DATABASE_URL=postgresql://user:password@localhost:5432/career_platform

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=4000

# Allowed browser origins, comma-separated. Leave unset in development to allow all.
CORS_ORIGIN=

# Public URL of the frontend, used in password-reset emails
APP_URL=http://localhost:5173

# Email for sign-up confirmation and password resets. Without any option, emails are printed to the log.
# Option 1 (recommended on Render's free plan, which blocks SMTP) — Brevo: free 300 emails/day.
# Verify your sender address under Senders, then create an API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Option 2 — Gmail: turn on 2-Step Verification, create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option 3 — Resend (needs a verified domain to email other people)
RESEND_API_KEY=
# Optional sender shown to users, e.g. "Student Career Platform <you@gmail.com>"
EMAIL_FROM=

# "Sign in with Google": OAuth client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Comma-separated emails that become admins when they log in
ADMIN_EMAILS=

# AI chat assistant + interview feedback
GEMINI_API_KEY=

# Optional: Cloudflare R2 file uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
