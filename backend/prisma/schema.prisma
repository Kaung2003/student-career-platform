// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

enum CertStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum InterviewCategory {
  BEHAVIORAL
  TECHNICAL
  SITUATIONAL
}

enum FeedbackType {
  BUG
  FEATURE
  COMMENT
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum NotificationType {
  COMMENT
  FEEDBACK_UPDATE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  suspended Boolean  @default(false)

  profile           StudentProfile?
  certifications    Certification[]
  interviewAttempts InterviewAttempt[]
  feedback          Feedback[]
  comments          Comment[]
  resetTokens       PasswordResetToken[]
  conversations     ChatConversation[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id          String     @id @default(cuid())
  name        String
  provider    String?
  examDate    DateTime?
  status      CertStatus @default(PLANNING)
  notes       String?
  resourceUrl String?

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model InterviewQuestion {
  id       String             @id @default(cuid())
  category InterviewCategory
  prompt   String
  tip      String?

  attempts InterviewAttempt[]

  createdAt DateTime @default(now())
}

model InterviewAttempt {
  id       String  @id @default(cuid())
  answer   String
  feedback String?

  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Feedback {
  id      String       @id @default(cuid())
  type    FeedbackType
  message String
  status  FeedbackStatus @default(NEW)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model StudentProfile {
  id        String   @id @default(cuid())
  slug      String   @unique

  headline  String?
  bio       String?
  school    String?
  gradYear  Int?
  skills    String[] @default([])
  github    String?
  linkedin  String?
  website   String?
  resumeUrl String?
  transcriptUrl String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique

  projects  Project[]
  comments  Comment[]
  views     ProfileView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id   String @id @default(cuid())
  body String

  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  techStack   String[] @default([])
  projectUrl  String?
  githubUrl   String?
  imageUrl    String?

  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model ChatConversation {
  id    String @id @default(cuid())
  title String

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id      String   @id @default(cuid())
  role    ChatRole
  content String

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model ProfileView {
  id String @id @default(cuid())
  // Hash of viewer IP + day, so repeat visits on the same day count once. Never the raw IP.
  visitorHash String

  profile   StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String

  createdAt DateTime @default(now())

  @@unique([profileId, visitorHash])
  @@index([profileId, createdAt])
}

model Notification {
  id     String           @id @default(cuid())
  type   NotificationType
  // Rendered by the client in the reader's language, e.g. { "name": "Ada", "slug": "ada" }.
  data   Json
  readAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  targetType String
  targetId   String?
  details    Json?

  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}
